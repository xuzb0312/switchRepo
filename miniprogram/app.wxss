/* 全局深色主题 + 黄色强调色 */
page {
  background-color: #121212;
  color: #ffffff;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

/* 通用卡片 */
.card {
  background: #1e1e1e;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

/* 通用按钮 */
.btn-primary {
  background: #FFD700;
  color: #1a1a1a;
  font-weight: bold;
  border-radius: 40rpx;
  font-size: 28rpx;
  text-align: center;
  line-height: 2.5;
}

.btn-primary::after {
  border: none;
}

/* 搜索框 */
.search-bar {
  background: #2a2a2a;
  border-radius: 40rpx;
  padding: 16rpx 30rpx;
  display: flex;
  align-items: center;
}

.search-bar input {
  flex: 1;
  color: #fff;
  font-size: 28rpx;
  margin-left: 16rpx;
}

.search-bar .placeholder {
  color: #666;
}

/* 平台标签 */
.platform-tag {
  display: inline-block;
  padding: 10rpx 24rpx;
  background: #2a2a2a;
  color: #888;
  border-radius: 30rpx;
  font-size: 24rpx;
  margin-right: 16rpx;
  white-space: nowrap;
}

.platform-tag.active {
  background: #FFD700;
  color: #1a1a1a;
  font-weight: bold;
}

/* 游戏卡片 */
.game-card {
  background: #1e1e1e;
  border-radius: 16rpx;
  overflow: hidden;
  display: flex;
  margin-bottom: 20rpx;
}

.game-card .cover {
  width: 180rpx;
  height: 180rpx;
  flex-shrink: 0;
}

.game-card .info {
  flex: 1;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.game-card .name {
  font-size: 30rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 8rpx;
}

.game-card .tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.game-card .tag {
  background: #2a2a2a;
  color: #FFD700;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.game-card .desc {
  font-size: 24rpx;
  color: #888;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.game-card .btn-detail {
  background: #FFD700;
  color: #1a1a1a;
  font-size: 22rpx;
  padding: 0 20rpx;
  border-radius: 30rpx;
  line-height: 2.2;
  align-self: flex-end;
  margin-top: auto;
}

/* 底部安全区 */
.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
