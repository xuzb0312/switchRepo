.container {
  background: #121212;
  min-height: 100vh;
}

.cover {
  width: 100%;
}

.info-card {
  margin: 20rpx;
  margin-top: -60rpx;
  position: relative;
  z-index: 1;
  border-radius: 16rpx 16rpx 0 0;
}

.title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 16rpx;
}

.tags {
  display: flex;
  gap: 12rpx;
}

.tag {
  background: #2a2a2a;
  color: #FFD700;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.view-count {
  color: #888;
  background: #1e1e1e;
}

.card {
  background: #1e1e1e;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 0 20rpx 20rpx;
}

.card-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #FFD700;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #333;
}

.desc {
  font-size: 28rpx;
  color: #ccc;
  line-height: 1.8;
}

.download-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.download-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #2a2a2a;
  border-radius: 12rpx;
  padding: 20rpx;
}

.link-type {
  display: block;
  font-size: 22rpx;
  color: #FFD700;
  margin-bottom: 4rpx;
}

.link-name {
  font-size: 26rpx;
  color: #fff;
  max-width: 400rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.btn-copy {
  background: #FFD700;
  color: #1a1a1a;
  font-size: 24rpx;
  font-weight: bold;
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
}

.screenshots {
  white-space: nowrap;
}

.screenshot {
  width: 280rpx;
  height: 180rpx;
  border-radius: 12rpx;
  margin-right: 16rpx;
  display: inline-block;
}

/* 解锁卡片 */
.lock-card {
  text-align: center;
  padding: 60rpx 40rpx;
}

.lock-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
}

.lock-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #FFD700;
  margin-bottom: 16rpx;
}

.lock-desc {
  display: block;
  font-size: 28rpx;
  color: #888;
  margin-bottom: 40rpx;
}

.btn-unlock {
  background: #FFD700;
  color: #1a1a1a;
  font-size: 32rpx;
  font-weight: bold;
  padding: 24rpx 60rpx;
  border-radius: 40rpx;
  display: inline-block;
}

/* 模糊预览 */
.preview-card .desc.blurred {
  filter: blur(6px);
  user-select: none;
  pointer-events: none;
}

.loading {
  text-align: center;
  color: #666;
  padding: 200rpx 0;
}
