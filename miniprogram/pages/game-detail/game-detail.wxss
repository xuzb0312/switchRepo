.container {
  background: #121212;
  min-height: 100vh;
}

.cover {
  width: 100%;
}

.info-card {
  margin: 20rpx;
  margin-top: -60rpx;
  position: relative;
  z-index: 1;
  border-radius: 16rpx 16rpx 0 0;
}

.title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 16rpx;
}

.card {
  background: #1e1e1e;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 0 20rpx 20rpx;
}

.card-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #FFD700;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #333;
}

.desc {
  font-size: 28rpx;
  color: #ccc;
  line-height: 1.8;
}

.download-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.download-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #2a2a2a;
  border-radius: 12rpx;
  padding: 20rpx;
}

.link-type {
  display: block;
  font-size: 22rpx;
  color: #FFD700;
  margin-bottom: 4rpx;
}

.link-name {
  font-size: 26rpx;
  color: #fff;
  max-width: 400rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.btn-copy {
  background: #FFD700;
  color: #1a1a1a;
  font-size: 24rpx;
  font-weight: bold;
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
}

.screenshots {
  white-space: nowrap;
}

.screenshot {
  width: 280rpx;
  height: 180rpx;
  border-radius: 12rpx;
  margin-right: 16rpx;
  display: inline-block;
}

.loading {
  text-align: center;
  color: #666;
  padding: 200rpx 0;
}
