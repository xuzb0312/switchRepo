.container {
  min-height: 100vh;
  background: #f5f5f5;
}

.cover {
  width: 100%;
}

.content {
  padding: 30rpx;
}

.header {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.platform {
  font-size: 24rpx;
  color: #ff6b6b;
  background: #ffeaea;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #eee;
}

.desc {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

.download-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.download-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
}

.link-type {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-bottom: 4rpx;
}

.link-name {
  font-size: 28rpx;
  color: #333;
}

.btn-download {
  background: #ff6b6b;
  color: #fff;
  font-size: 26rpx;
  padding: 0 30rpx;
  border-radius: 30rpx;
  line-height: 2.4;
}

.screenshot {
  width: 300rpx;
  height: 200rpx;
  border-radius: 12rpx;
  margin-right: 16rpx;
}
