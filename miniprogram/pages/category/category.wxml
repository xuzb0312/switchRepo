<view class="container">
  <!-- 顶部搜索 -->
  <view class="search-bar" bindtap="onSearchTap">
    <text class="icon">🔍</text>
    <input placeholder="搜索游戏..." placeholder-class="placeholder" bindinput="onSearch" />
  </view>

  <!-- 平台筛选 -->
  <scroll-view class="platforms" scroll-x>
    <text class="platform-tag {{currentPlatform === item.value ? 'active' : ''}}" 
          wx:for="{{platforms}}" 
          wx:key="value"
          bindtap="onSelectPlatform"
          data-platform="{{item.value}}">{{item.name}}</text>
  </scroll-view>

  <!-- 结果统计 -->
  <view class="result-header">
    <text class="result-count">{{games.length}} 个结果</text>
  </view>

  <!-- 游戏列表 -->
  <view class="game-list">
    <view class="game-card" wx:for="{{games}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
      <image class="cover" src="{{item.coverImage}}" mode="aspectFill" />
      <view class="info">
        <text class="name">{{item.name}}</text>
        <view class="tags">
          <text class="tag">{{item.platform}}</text>
          <text class="tag" wx:if="{{item.type}}">{{item.type}}</text>
        </view>
        <text class="desc">{{item.description}}</text>
        <view class="btn-detail">查看详情</view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty" wx:if="{{games.length === 0 && !loading}}">
    <text>暂无游戏</text>
  </view>
</view>
