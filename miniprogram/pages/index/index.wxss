.container {
  padding: 20rpx;
}

.search-bar {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 30rpx;
  margin-bottom: 20rpx;
}

.search-bar input {
  font-size: 28rpx;
}

.platforms {
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.platform-tag {
  display: inline-block;
  padding: 12rpx 28rpx;
  background: #fff;
  border-radius: 30rpx;
  margin-right: 16rpx;
  font-size: 26rpx;
  color: #666;
}

.platform-tag.active {
  background: #ff6b6b;
  color: #fff;
}

.game-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.game-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  display: flex;
}

.game-cover {
  width: 200rpx;
  height: 200rpx;
}

.game-info {
  flex: 1;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.game-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.game-platform {
  font-size: 22rpx;
  color: #ff6b6b;
  margin-bottom: 12rpx;
}

.game-desc {
  font-size: 24rpx;
  color: #888;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.empty-tip {
  text-align: center;
  color: #999;
  padding: 100rpx 0;
  font-size: 28rpx;
}
